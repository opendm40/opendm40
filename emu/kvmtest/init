#!/bin/sh
# Guest init: attach the emulated DM40 over usbip (vhci-hcd, the real
# usb-storage / sd / vfat path), start an AD2 stream, copy the slow-bank
# INFO/ files while it runs (served from the SPI mirror: the copy finishes
# while the stream runs; without a mirror it waits for the stream's end).
# Parameters from the kernel command line:
#   dm40port=<usbip port on the host>  dm40dur=<LOG:DURation s>
#   dm40direct=1: first an O_DIRECT read of CALIB.BIN (dd iflag=direct)
#   dm40wait=<s>: start the copies only after the stream ran this long
#   dm40rate=<S/s>: LOG:SRATe (default 38400; 76800: the writer trial, then
#     the copies dm40wait s into the run, fw-rs vdisk.rs mirror pacing)
#   dm40rounds=<n>: copy the four files n times (default 1)
export PATH=/bin LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev
mkdir -p /var/run/vhci_hcd /tmp
for a in $(cat /proc/cmdline); do case $a in dm40*=*) eval "$a";; esac; done
: ${dm40port:=39020} ${dm40dur:=20} ${dm40direct:=} ${dm40rate:=38400} ${dm40rounds:=1}
log() { echo "[$(cut -d' ' -f1 /proc/uptime)] $*"; }
for m in nls_iso8859-1 usbip-core vhci-hcd usb-storage usbtmc; do insmod /lib/modules/$m.ko; done
ip link set lo up; ip link set eth0 up; ip addr add 10.0.2.15/24 dev eth0; ip route add default via 10.0.2.2
log "attach 10.0.2.2:$dm40port"
for i in 1 2 3 4 5; do /bin/usbip-real --tcp-port $dm40port attach -r 10.0.2.2 -b 1-0 && break; sleep 3; done
for i in $(seq 60); do [ -b /dev/sda ] && [ -c /dev/usbtmc0 ] && break; sleep 1; done
ls -l /dev/sda /dev/usbtmc0
log "sd timeout $(cat /sys/block/sda/device/timeout) s"
q() { echo "$1" > /dev/usbtmc0; case "$1" in *\?*) dd if=/dev/usbtmc0 bs=4096 count=1 2>/dev/null;; esac; }
mount -t vfat -o ro /dev/sda /mnt || log "mount failed"
ls -l /mnt/INFO
q '*IDN?'
log "DBG:VDISK:MIR? $(q 'DBG:VDISK:MIR?') (served, status, rewritten, ms)"
# Reference copies with no stream running.
for f in CALIB.BIN BOOTDATA.BIN LOADER.BIN FIRMWARE.BIN; do cat /mnt/INFO/$f > /tmp/ref.$f; done
md5sum /tmp/ref.*
echo 3 > /proc/sys/vm/drop_caches
q '*CLS'
q 'CONF:VOLT:AC'; q 'LOG:SOURce AD2'; q "LOG:SRATe $dm40rate"; q 'LOG:CHOP ON'; sleep 3
q 'LOG:DEST DISK'; q "LOG:DURation $dm40dur"; q 'LOG:STATe ON'; q 'SYST:ERR?'
for i in $(seq 120); do s=$(q 'LOG:DISK?'); case "$s" in 3,*) break;; esac; sleep 0.5; done
log "LOG:DISK? $s"
q 'DBG:ISR?'
if [ -n "$dm40wait" ]; then
    # Copy only after the stream has run this long (s): past the 180 s a
    # NOT READY answer could be retried for.
    log "waiting $dm40wait s with the stream running"
    sleep $dm40wait
fi
t0=$(cut -d' ' -f1 /proc/uptime)
log "copy start (stream running, LOG:DISK? $(q 'LOG:DISK?'), LOG:COUNt? $(q 'LOG:COUNt?'))"
if [ -n "$dm40direct" ]; then
    # O_DIRECT: no page-cache fallback, the reader sees the SCSI result.
    dd if=/mnt/INFO/CALIB.BIN of=/tmp/direct.bin bs=4096 iflag=direct; rc=$?
    log "dd O_DIRECT CALIB.BIN: exit $rc, LOG:DISK? $(q 'LOG:DISK?')"
fi
for r in $(seq $dm40rounds); do
for f in CALIB.BIN BOOTDATA.BIN LOADER.BIN FIRMWARE.BIN; do
    echo 3 > /proc/sys/vm/drop_caches
    t1=$(cut -d' ' -f1 /proc/uptime)
    cat /mnt/INFO/$f > /tmp/got.$f; rc=$?
    log "cat $f: exit $rc, $(awk -v a=$t1 '{print $1 - a}' /proc/uptime) s, LOG:DISK? $(q 'LOG:DISK?'), LOG:COUNt? $(q 'LOG:COUNt?')"
done
done
s=$(q 'LOG:DISK?')
log "copy end, $(awk -v a=$t0 '{print $1 - a}' /proc/uptime) s, LOG:DISK? $s"
case "$s" in 3,*) echo "COPIED DURING THE STREAM";; *) echo "the stream had ended";; esac
q 'DBG:ISR?'
log "LOG:COUNt? $(q 'LOG:COUNt?') (state, captured, overwritten = lost, ...)"
log "DBG:VDISK:MIR? $(q 'DBG:VDISK:MIR?') (..., mirror sectors read while streaming, held, longest hold ms)"
for f in CALIB.BIN BOOTDATA.BIN LOADER.BIN FIRMWARE.BIN; do cmp /tmp/ref.$f /tmp/got.$f && echo "same: $f" || echo "DIFF: $f"; done
dmesg | grep -iE "sense|not ready|i/o error|timing out|reset|sd 0" | tail -40
log "DONE"
reboot -f
